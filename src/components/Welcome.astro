---
const events = [
	{
		id: 'pipeline-sicherheit',
		type: 'Fachkonferenz',
		title: 'Pipeline-Sicherheit 2026',
		date: '24. Mai 2026',
		time: '18:00',
		location: 'Zürich, Energieforum',
		price: 'gratis',
		capacity: 48,
		booked: 36,
		status: 'Noch 12 Plätze',
		format: 'Vor Ort',
		description:
			'Strategien für Leckageerkennung, Wartung und digitale Überwachung von Gasinfrastruktur.',
		agenda: ['Keynote Sicherheitslage', 'Praxisfälle Sensorik', 'Q&A mit Netzbetreibern'],
		participants: [
			{ name: 'Mira Keller', company: 'Gasnetz Zürich', status: 'bestätigt' },
			{ name: 'Jonas Frei', company: 'EnerFlux AG', status: 'bestätigt' },
			{ name: 'Claudia Meier', company: 'RegioGas Ost', status: 'wartet' },
		],
	},
	{
		id: 'smart-gas-networks',
		type: 'Roundtable',
		title: 'Smart Gas Networks',
		date: '28. Mai 2026',
		time: '20:00',
		location: 'Basel, Smart Utility Hub',
		price: 'CHF 119 .-',
		capacity: 26,
		booked: 22,
		status: 'Begrenzt verfügbar',
		format: 'Vor Ort',
		description:
			'Diskussion zu digitaler Vernetzung von Gasnetz, IoT-Sensorik und Energiemanagement.',
		agenda: ['IoT-Impuls', 'Moderierte Diskussion', 'Networking-Apéro'],
		participants: [
			{ name: 'Luca Steiner', company: 'UtilityWorks', status: 'bestätigt' },
			{ name: 'Nina Vogt', company: 'SensorGrid', status: 'bestätigt' },
			{ name: 'Rafael Schmid', company: 'Stadtwerke Bern', status: 'bestätigt' },
		],
	},
	{
		id: 'gashandel-marktanalyse',
		type: 'Hybrid Event',
		title: 'Gashandel & Marktanalyse',
		date: '31. Mai 2026',
		time: '16:00',
		location: 'Online + Winterthur',
		price: 'CHF 39 .-',
		capacity: 120,
		booked: 74,
		status: 'Online + vor Ort',
		format: 'Hybrid',
		description:
			'Analyse von Markttrends, Kapazitätsplanung und Preisentwicklung im EU-Gassektor.',
		agenda: ['Marktüberblick', 'Preis-Szenarien', 'Kapazitätsplanung'],
		participants: [
			{ name: 'Sven Berger', company: 'TradeScope', status: 'bestätigt' },
			{ name: 'Aylin Yilmaz', company: 'GasHub Europe', status: 'bestätigt' },
			{ name: 'Theo Graf', company: 'NordKap Energie', status: 'wartet' },
		],
	},
];
---

<div class="page-shell" data-event-app>
	<header class="app-header">
		<div>
			<p class="eyebrow">Event-Buchungstool Demo</p>
			<h1>GasConnect</h1>
			<p class="hero-text">
				Ein klickbarer Prototyp für Events, Teilnehmerlisten und einfache Admin-Abläufe in der
				Energiebranche.
			</p>
		</div>
		<nav class="quick-nav" aria-label="Bereiche">
			<a href="#events">Events</a>
			<a href="#details">Details</a>
			<a href="#admin">Admin</a>
		</nav>
	</header>

	<main class="workspace">
		<section id="events" class="event-column" aria-labelledby="events-title">
			<div class="section-header compact">
				<p class="section-label">Branchenevents Gasversorgung</p>
				<h2 id="events-title">Events</h2>
			</div>

			<div class="grid-list" data-event-list>
				{
					events.map((event, index) => (
						<button
							class={`event-card ${index === 1 ? 'highlighted' : ''}`}
							type="button"
							data-event-card
							data-event-id={event.id}
						>
							<span class="event-type">{event.type}</span>
							<strong>{event.title}</strong>
							<span class="event-description">{event.description}</span>
							<span class="event-details">
								<span>
									{event.date} · {event.time}
								</span>
								<span>{event.price}</span>
							</span>
							<span class="event-status">
								<span class={`pill ${event.booked / event.capacity > 0.8 ? 'limited' : 'available'}`}>
									{event.status}
								</span>
								<span class="action-link">Details öffnen</span>
							</span>
						</button>
					))
				}
			</div>
		</section>

		<section id="details" class="detail-panel" aria-live="polite">
			<div class="panel-header">
				<div>
					<p class="section-label" data-detail-type>{events[0].type}</p>
					<h2 data-detail-title>{events[0].title}</h2>
				</div>
				<span class="pill available" data-detail-status>{events[0].status}</span>
			</div>

			<p class="detail-copy" data-detail-description>{events[0].description}</p>

			<div class="stat-grid">
				<div>
					<span data-detail-date>{events[0].date}</span>
					<p>Datum</p>
				</div>
				<div>
					<span data-detail-time>{events[0].time}</span>
					<p>Start</p>
				</div>
				<div>
					<span data-detail-price>{events[0].price}</span>
					<p>Preis</p>
				</div>
				<div>
					<span data-detail-seats>{events[0].capacity - events[0].booked}</span>
					<p>Freie Plätze</p>
				</div>
			</div>

			<div class="detail-split">
				<div>
					<h3>Agenda</h3>
					<ul class="agenda-list" data-detail-agenda>
						{events[0].agenda.map((item) => <li>{item}</li>)}
					</ul>
				</div>
				<div>
					<h3>Teilnehmerliste</h3>
					<ul class="participant-list" data-detail-participants>
						{
							events[0].participants.map((participant) => (
								<li>
									<span>{participant.name}</span>
									<small>
										{participant.company} · {participant.status}
									</small>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>
	</main>

	<section id="admin" class="admin-block" aria-labelledby="admin-title">
		<div class="section-header">
			<p class="section-label">Admin-Dashboard</p>
			<h2 id="admin-title">Events bearbeiten und erstellen</h2>
			<p class="section-copy">
				Änderungen werden im Prototyp direkt in der Oberfläche sichtbar und bleiben lokal in dieser
				Sitzung.
			</p>
		</div>

		<div class="admin-grid">
			<form class="admin-form" data-admin-form>
				<input type="hidden" name="id" value={events[0].id} />

				<label>
					Event auswählen
					<select name="selectedEvent" data-admin-select>
						{events.map((event) => <option value={event.id}>{event.title}</option>)}
					</select>
				</label>

				<div class="form-row">
					<label>
						Titel
						<input name="title" value={events[0].title} required />
					</label>
					<label>
						Typ
						<input name="type" value={events[0].type} required />
					</label>
				</div>

				<div class="form-row">
					<label>
						Datum
						<input name="date" value={events[0].date} required />
					</label>
					<label>
						Start
						<input name="time" value={events[0].time} required />
					</label>
				</div>

				<div class="form-row">
					<label>
						Preis
						<input name="price" value={events[0].price} required />
					</label>
					<label>
						Kapazität
						<input name="capacity" type="number" min="1" value={events[0].capacity} required />
					</label>
				</div>

				<label>
					Ort
					<input name="location" value={events[0].location} required />
				</label>

				<label>
					Beschreibung
					<textarea name="description" rows="4" required>{events[0].description}</textarea>
				</label>

				<div class="button-row">
					<button class="cta-button" type="submit">Speichern</button>
					<button class="secondary-button" type="button" data-new-event>Neuer Event</button>
				</div>
			</form>

			<aside class="admin-summary">
				<h3>Übersicht</h3>
				<div class="metric-row">
					<div>
						<span data-total-reservations>132</span>
						<p>Reservierungen</p>
					</div>
					<div>
						<span data-total-events>{events.length}</span>
						<p>Events</p>
					</div>
					<div>
						<span data-total-capacity>194</span>
						<p>Plätze</p>
					</div>
				</div>
				<div class="activity-feed">
					<h4>Letzte Aktivität</h4>
					<ul data-activity-feed>
						<li>Pipeline-Sicherheit 2026 aktualisiert</li>
						<li>3 neue Reservierungen importiert</li>
						<li>Smart Gas Networks fast ausgebucht</li>
					</ul>
				</div>
			</aside>
		</div>
	</section>
</div>

<script define:vars={{ initialEvents: events }}>
	const events = structuredClone(initialEvents);
	const app = document.querySelector('[data-event-app]');
	const eventList = app?.querySelector('[data-event-list]');
	const adminForm = app?.querySelector('[data-admin-form]');
	const adminSelect = app?.querySelector('[data-admin-select]');
	const activityFeed = app?.querySelector('[data-activity-feed]');
	let activeEventId = events[0].id;

	const participantNames = [
		['Lea Brunner', 'SwissGas Control'],
		['Marc Widmer', 'Netzwerk Energie'],
		['Sofia Roth', 'TransitGas AG'],
		['David Amrein', 'Alpine Utility'],
	];

	function getActiveEvent() {
		return events.find((event) => event.id === activeEventId) ?? events[0];
	}

	function getAvailabilityClass(event) {
		return event.booked / event.capacity > 0.8 ? 'limited' : 'available';
	}

	function slugify(value) {
		return value
			.toLowerCase()
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '');
	}

	function escapeHtml(value) {
		return value
			.toString()
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#039;');
	}

	function renderEventList() {
		if (!eventList) return;

		eventList.innerHTML = events
			.map(
				(event) => `
					<button class="event-card ${event.id === activeEventId ? 'is-active' : ''}" type="button" data-event-card data-event-id="${event.id}">
						<span class="event-type">${escapeHtml(event.type)}</span>
						<strong>${escapeHtml(event.title)}</strong>
						<span class="event-description">${escapeHtml(event.description)}</span>
						<span class="event-details">
							<span>${escapeHtml(event.date)} · ${escapeHtml(event.time)}</span>
							<span>${escapeHtml(event.price)}</span>
						</span>
						<span class="event-status">
							<span class="pill ${getAvailabilityClass(event)}">${escapeHtml(event.status)}</span>
							<span class="action-link">Details öffnen</span>
						</span>
					</button>
				`,
			)
			.join('');
	}

	function renderDetails() {
		const event = getActiveEvent();
		const freeSeats = Math.max(event.capacity - event.booked, 0);

		app.querySelector('[data-detail-type]').textContent = event.type;
		app.querySelector('[data-detail-title]').textContent = event.title;
		app.querySelector('[data-detail-description]').textContent = event.description;
		app.querySelector('[data-detail-date]').textContent = event.date;
		app.querySelector('[data-detail-time]').textContent = event.time;
		app.querySelector('[data-detail-price]').textContent = event.price;
		app.querySelector('[data-detail-seats]').textContent = freeSeats;

		const status = app.querySelector('[data-detail-status]');
		status.textContent = event.status;
		status.className = `pill ${getAvailabilityClass(event)}`;

		app.querySelector('[data-detail-agenda]').innerHTML = event.agenda
			.map((item) => `<li>${escapeHtml(item)}</li>`)
			.join('');

		app.querySelector('[data-detail-participants]').innerHTML = event.participants
			.map(
				(participant) => `
					<li>
						<span>${escapeHtml(participant.name)}</span>
						<small>${escapeHtml(participant.company)} · ${escapeHtml(participant.status)}</small>
					</li>
				`,
			)
			.join('');
	}

	function renderAdminOptions() {
		if (!adminSelect) return;

		adminSelect.innerHTML = events
			.map((event) => `<option value="${event.id}">${escapeHtml(event.title)}</option>`)
			.join('');
		adminSelect.value = activeEventId;
	}

	function fillAdminForm(event) {
		if (!adminForm) return;

		adminForm.elements.id.value = event.id;
		adminForm.elements.selectedEvent.value = event.id;
		adminForm.elements.title.value = event.title;
		adminForm.elements.type.value = event.type;
		adminForm.elements.date.value = event.date;
		adminForm.elements.time.value = event.time;
		adminForm.elements.price.value = event.price;
		adminForm.elements.capacity.value = event.capacity;
		adminForm.elements.location.value = event.location;
		adminForm.elements.description.value = event.description;
	}

	function renderSummary() {
		app.querySelector('[data-total-events]').textContent = events.length;
		app.querySelector('[data-total-reservations]').textContent = events.reduce(
			(total, event) => total + event.booked,
			0,
		);
		app.querySelector('[data-total-capacity]').textContent = events.reduce(
			(total, event) => total + event.capacity,
			0,
		);
	}

	function addActivity(text) {
		if (!activityFeed) return;

		const item = document.createElement('li');
		item.textContent = text;
		activityFeed.prepend(item);

		while (activityFeed.children.length > 4) {
			activityFeed.lastElementChild?.remove();
		}
	}

	function syncView() {
		renderEventList();
		renderDetails();
		renderAdminOptions();
		fillAdminForm(getActiveEvent());
		renderSummary();
	}

	eventList?.addEventListener('click', (event) => {
		const card = event.target.closest('[data-event-card]');
		if (!card) return;

		activeEventId = card.dataset.eventId;
		syncView();
		document.querySelector('#details')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
	});

	adminSelect?.addEventListener('change', (event) => {
		activeEventId = event.target.value;
		syncView();
	});

	adminForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		const form = new FormData(adminForm);
		const currentEvent = getActiveEvent();

		currentEvent.title = form.get('title').toString();
		currentEvent.type = form.get('type').toString();
		currentEvent.date = form.get('date').toString();
		currentEvent.time = form.get('time').toString();
		currentEvent.price = form.get('price').toString();
		currentEvent.capacity = Number(form.get('capacity'));
		currentEvent.location = form.get('location').toString();
		currentEvent.description = form.get('description').toString();
		currentEvent.status =
			currentEvent.capacity - currentEvent.booked <= 6 ? 'Begrenzt verfügbar' : `Noch ${currentEvent.capacity - currentEvent.booked} Plätze`;

		addActivity(`${currentEvent.title} gespeichert`);
		syncView();
	});

	app?.querySelector('[data-new-event]')?.addEventListener('click', () => {
		const nextNumber = events.length + 1;
		const newEvent = {
			id: `neuer-event-${Date.now()}`,
			type: 'Workshop',
			title: `Neuer GasConnect Event ${nextNumber}`,
			date: '06. Juni 2026',
			time: '17:30',
			location: 'Luzern, Energie Campus',
			price: 'CHF 59 .-',
			capacity: 40,
			booked: 0,
			status: 'Noch 40 Plätze',
			format: 'Vor Ort',
			description: 'Frisch angelegter Demo-Event, der direkt bearbeitet werden kann.',
			agenda: ['Begrüssung', 'Fachinput', 'Austausch'],
			participants: participantNames.slice(0, 2).map(([name, company]) => ({
				name,
				company,
				status: 'eingeladen',
			})),
		};

		newEvent.id = `${slugify(newEvent.title)}-${Date.now().toString().slice(-4)}`;
		events.push(newEvent);
		activeEventId = newEvent.id;
		addActivity(`${newEvent.title} erstellt`);
		syncView();
		document.querySelector('#admin')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	syncView();
</script>

<style>
	.page-shell {
		position: relative;
		padding: 32px clamp(16px, 4vw, 72px) 56px;
		max-width: 1320px;
		margin: 0 auto;
		min-height: 100vh;
	}

	.app-header {
		display: flex;
		justify-content: space-between;
		gap: 28px;
		align-items: flex-end;
		padding: 28px 0 34px;
	}

	.eyebrow,
	.section-label {
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #67e8f9;
		font-size: 0.78rem;
		margin: 0 0 10px;
		font-weight: 800;
	}

	h1 {
		font-size: clamp(2.9rem, 6vw, 5.2rem);
		line-height: 0.92;
		margin: 0;
		max-width: 12ch;
	}

	.hero-text {
		margin: 18px 0 0;
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 1.7;
		color: #cbd5e1;
	}

	.quick-nav {
		display: flex;
		gap: 8px;
		padding: 6px;
		border: 1px solid rgba(148, 163, 184, 0.2);
		background: rgba(15, 23, 42, 0.72);
		border-radius: 999px;
	}

	.quick-nav a {
		color: #f8fafc;
		text-decoration: none;
		font-weight: 800;
		padding: 10px 14px;
		border-radius: 999px;
	}

	.quick-nav a:hover {
		background: rgba(20, 184, 166, 0.18);
	}

	.workspace {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(360px, 0.78fr);
		gap: 24px;
		align-items: start;
	}

	.section-header {
		max-width: 760px;
		margin-bottom: 22px;
	}

	.section-header.compact {
		margin-bottom: 16px;
	}

	.section-header h2,
	.panel-header h2,
	.admin-summary h3 {
		font-size: clamp(1.75rem, 3vw, 2.55rem);
		line-height: 1.05;
		margin: 0;
	}

	.section-copy {
		margin: 12px 0 0;
		color: #cbd5e1;
		line-height: 1.7;
	}

	.grid-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	:global(.event-card),
	.detail-panel,
	.admin-form,
	.admin-summary {
		background: rgba(15, 23, 42, 0.9);
		border: 1px solid rgba(148, 163, 184, 0.18);
		border-radius: 8px;
		box-shadow: 0 24px 70px rgba(2, 6, 23, 0.28);
	}

	:global(.event-card) {
		display: flex;
		flex-direction: column;
		gap: 15px;
		min-height: 296px;
		padding: 22px;
		color: inherit;
		text-align: left;
		cursor: pointer;
		font: inherit;
		transition:
			border-color 180ms ease,
			transform 180ms ease,
			background 180ms ease;
	}

	:global(.event-card:hover),
	:global(.event-card.is-active) {
		border-color: rgba(45, 212, 191, 0.74);
		background: rgba(19, 78, 74, 0.52);
		transform: translateY(-2px);
	}

	:global(.event-card.highlighted) {
		border-color: rgba(251, 191, 36, 0.38);
	}

	:global(.event-type) {
		text-transform: uppercase;
		font-size: 0.74rem;
		letter-spacing: 0.15em;
		color: #fbbf24;
		font-weight: 900;
	}

	:global(.event-card strong) {
		display: block;
		font-size: 1.38rem;
		line-height: 1.15;
	}

	:global(.event-description),
	.detail-copy {
		margin: 0;
		color: #cbd5e1;
		line-height: 1.65;
	}

	:global(.event-details) {
		display: flex;
		justify-content: space-between;
		gap: 14px;
		margin-top: auto;
		font-weight: 800;
		color: #e2e8f0;
	}

	:global(.event-status),
	.button-row,
	.panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	:global(.pill) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: max-content;
		padding: 8px 12px;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 900;
		white-space: nowrap;
	}

	:global(.pill.available) {
		background: rgba(34, 197, 94, 0.14);
		color: #86efac;
	}

	:global(.pill.limited) {
		background: rgba(251, 191, 36, 0.16);
		color: #fde68a;
	}

	:global(.action-link) {
		color: #67e8f9;
		font-weight: 900;
		text-decoration: none;
	}

	.detail-panel {
		position: sticky;
		top: 20px;
		padding: 26px;
		display: grid;
		gap: 22px;
	}

	.stat-grid,
	.metric-row {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 10px;
	}

	.stat-grid div,
	.metric-row div {
		background: rgba(2, 6, 23, 0.36);
		border: 1px solid rgba(148, 163, 184, 0.12);
		border-radius: 8px;
		padding: 14px;
		min-width: 0;
	}

	.stat-grid span,
	.metric-row span {
		display: block;
		font-size: 1.15rem;
		font-weight: 900;
		color: #ffffff;
		overflow-wrap: anywhere;
	}

	.stat-grid p,
	.metric-row p {
		margin: 6px 0 0;
		color: #94a3b8;
		font-size: 0.86rem;
	}

	.detail-split {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 20px;
	}

